# AIMBULENCE frontend environment template.
# Copy to `.env.local` for local development. `.env.local` is gitignored.
#
# NEVER place an API key, token, or credential in this file or in any other
# file under frontend/. Backend credentials live exclusively in the backend
# process (instruction.md section 11).

# ---------------------------------------------------------------------------
# SERVER-ONLY configuration
# ---------------------------------------------------------------------------
# Read only in Node/server code (src/lib/config.ts). These values are not
# inlined into the browser bundle, so the internal backend host is never
# disclosed to the client.

# Preferred: explicit backend origin.
BACKEND_BASE_URL=http://localhost:8000

# Alternative: host + port. Both are required together.
# Note: 0.0.0.0 is a bind address and is rewritten to localhost for outbound
# requests, because it is not a dialable destination.
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# Per-request timeout in milliseconds. Optional; defaults to 10000.
# API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PUBLIC configuration
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values ARE inlined into the browser bundle. Only non-sensitive
# display strings belong here.

NEXT_PUBLIC_APP_NAME=AIMBULENCE
NEXT_PUBLIC_APP_TAGLINE=AI Emergency Hospital Operations Runbook Executor
