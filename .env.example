# AIMBULENCE Environment Variables Template
# Copy this file to .env and populate with your own credentials.
# NEVER commit .env to version control!

# TrueForge Configuration (Mandatory Hackathon Agent Harness)
TRUEFORGE_API_KEY=your_trueforge_api_key_here
TRUEFORGE_ENVIRONMENT=development

# LLM Provider Configuration
LLM_PROVIDER=openai  # or anthropic / gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o

# Database Configuration (Real Connected Operational System)
DATABASE_URL=sqlite:///./hospital_operations.db

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Safety & Execution Environment
ENABLE_SANDBOX=true
ENVIRONMENT=development
LOG_LEVEL=INFO
