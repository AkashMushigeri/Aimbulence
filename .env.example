# AIMBULENCE Environment Variables Template
# Copy this file to .env and populate with your own credentials.
# NEVER commit .env to version control!

# Application Environment
APP_ENV=development
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration (Real Connected Operational System - SQLite)
DATABASE_URL=sqlite:///./hospital_operations.db

# TrueForge Configuration (Mandatory Hackathon Agent Harness - Requires Node.js 22+)
TRUEFORGE_API_KEY=your_trueforge_api_key_here
TRUEFORGE_ENVIRONMENT=development

# LLM Provider Configuration (Phase 3)
LLM_PROVIDER=openai  # or anthropic / gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o

# Safety & Execution Environment
ENABLE_SANDBOX=true
LOG_LEVEL=INFO
